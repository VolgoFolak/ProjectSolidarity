      border: 2.5px solid var(--primary,#4a6fa5);
      font-family: inherit;
      animation: fadeIn 0.2s;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.97);}
      to { opacity: 1; transform: scale(1);}
    }
    @media (max-width: 600px) {
      header {
        position: fixed;
