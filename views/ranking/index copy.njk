    }
    .user-league-badge.diamante {
      background: linear-gradient(90deg, #00c3ff 60%, #ffff1c 100%);
      color: #1a3a4a;
    }
    .progress-container {
      margin: 1.2rem 0 0.7rem 0;
      width: 100%;
    }
    .progress-bar-bg {
      background: #e5e7eb;
      border-radius: 20px;
      height: 18px;
      position: relative;
      width: 100%;
      margin: 0 auto;
      overflow: hidden;
    }
    .progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--secondary, #3da58a), var(--primary, #4a6fa5));
      border-radius: 20px;
      transition: width 0.5s;
    }
    .progress-label {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.98em;
      color: #222;
      font-weight: 600;
      height: 100%;
      display: flex;
      align-items: center;
    }
    .modal {
      display: none;
      position: fixed;
      z-index: 9999;
      left: 0; top: 0;
      width: 100vw; height: 100vh;
      background: rgba(0,0,0,0.35);
      align-items: center;
      justify-content: center;
    }
    .modal.active, .modal[style*="display: block"] {
      display: flex !important;
    }
    .modal-content {
      background: #fff;
      border-radius: 18px;
      max-width: 480px;
      width: 95vw;
      padding: 2.5rem 2.5rem 2rem 2.5rem;
