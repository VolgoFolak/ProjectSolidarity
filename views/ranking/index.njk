            Historial de puntos vacío. ¡Sé el primero en sumar puntos y aparecer aquí!
          </div>
        </div>
      </div>

      <!-- Causas Apoyadas -->
      <div style="margin-bottom:1.5rem;">
        <h3 style="color:var(--primary,#4a6fa5);font-size:1.3rem;margin-bottom:0.8rem;">Causas Apoyadas</h3>
        <div id="causes-supported" style="max-height:300px;overflow-y:auto;">
          <!-- Carga inicial de causas vacía -->
          <div style="text-align:center;color:#888;padding:1rem 0;">
            <i class="fas fa-hands-helping" style="font-size:2rem;margin-bottom:0.5rem;"></i><br>
            Aún no has apoyado ninguna causa. Explora y contribuye para que aparezca aquí.
          </div>
        </div>
      </div>

      <!-- Botón de cerrar sesión (solo para el usuario actual) -->
      <div id="logout-button-container" style="text-align:center;margin-top:1.5rem;">
        <button class="btn btn-primary" id="logout-button" style="width:100%;max-width:300px;">
          <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
        </button>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script>
async function fetchRankingData() {
  try {
    // ✅ CONSULTA CORREGIDA - Agregar más campos y debugging
    const { data: usersHistorico, error: errorHistorico } = await supabase
      .from('profiles')
      .select('id, username, first_name, last_name, photo_url, impact_points, weekly_points, created_at')
      .not('username', 'is', null)
      .order('impact_points', { ascending: false })
      .limit(100);

    const { data: usersDinamico, error: errorDinamico } = await supabase
      .from('profiles')
      .select('id, username, first_name, last_name, photo_url, impact_points, weekly_points, created_at')
      .not('username', 'is', null)
      .order('weekly_points', { ascending: false })
      .limit(100);

    // ✅ DEBUGGING - Ver qué datos llegan
    console.log('📊 Datos histórico:', usersHistorico);
    console.log('📊 Datos dinámico:', usersDinamico);
    console.log('❌ Errores:', errorHistorico, errorDinamico);

    if (errorHistorico) {
      console.error('Error cargando ranking histórico:', errorHistorico.message);
    }
    if (errorDinamico) {
      console.error('Error cargando ranking dinámico:', errorDinamico.message);
    }

    return { 
      usersHistorico: usersHistorico || [], 
      usersDinamico: usersDinamico || [] 
    };
  } catch (error) {
    console.error('Error fetching ranking data:', error);
    return { usersHistorico: [], usersDinamico: [] };
  }
}

// Función unificada para obtener liga (igual que en el controlador)
function getLeague(points) {
  if (points >= 5000) return { name: "Diamante", level: 5, icon: "fas fa-crown", color: "#00c3ff" };
  if (points >= 3000) return { name: "Platino", level: 4, icon: "fas fa-gem", color: "#e5e7eb" };
  if (points >= 2000) return { name: "Oro", level: 3, icon: "fas fa-award", color: "#ffd700" };
  if (points >= 1000) return { name: "Plata", level: 2, icon: "fas fa-star", color: "#c0c0c0" };
  return { name: "Bronce", level: 1, icon: "fas fa-seedling", color: "#cd7f32" };
}

// Función para obtener liga por nivel
function getLeagueByLevel(level) {
  const leagues = [
    { name: "Bronce", level: 1, icon: "fas fa-seedling", color: "#cd7f32" },
    { name: "Plata", level: 2, icon: "fas fa-star", color: "#c0c0c0" },
    { name: "Oro", level: 3, icon: "fas fa-award", color: "#ffd700" },
    { name: "Platino", level: 4, icon: "fas fa-gem", color: "#e5e7eb" },
    { name: "Diamante", level: 5, icon: "fas fa-crown", color: "#00c3ff" }
  ];
  return leagues.find(league => league.level === level) || leagues[0];
}

function renderIndividualRanking(users, type = "historico", currentUserId = null) {
  const tbody = document.getElementById('individual-ranking');
  tbody.innerHTML = '';
  if (!Array.isArray(users) || users.length === 0) {
    tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#888;">No hay datos para mostrar.</td></tr>`;
    return;
  }
  
  users.forEach((user, index) => {
    const points = type === "dinamico" 
      ? (user.weekly_points ?? 0) 
      : (user.impact_points ?? 0);
    const name = user.username ?? 'Usuario';
    const avatar = user.photo_url || '/img/avatar-default.jpg';
    const actions = user.actions_count ?? 0;
    
    // Obtener liga actual del usuario
    const userLeague = user.current_league 
      ? getLeagueByLevel(user.current_league)
      : getLeague(user.impact_points || 0);
    
    tbody.innerHTML += `
      <tr${user.id === currentUserId ? ' style="background:#e6f7f1;"' : ''}>
        <td>
          <span class="rank${index < 3 ? ` rank-${index + 1}` : ''}">${index + 1}</span>
        </td>
        <td>
          <div class="user-cell">
            <img src="${avatar}" class="user-avatar-sm" alt="Avatar">
            <div>
              <span>${name}</span>
              <div style="font-size:0.8rem;color:${userLeague.color};font-weight:600;">
                <i class="${userLeague.icon}"></i> ${userLeague.name}
              </div>
            </div>
          </div>
        </td>
        <td class="score">${points.toLocaleString()}</td>
        <td>-</td>
        <td>
          <button class="btn btn-sm btn-primary" onclick="showUserProfile('${user.username || user.id}', '${user.username}', '${avatar}', ${user.impact_points || 0})"
                  style="background:var(--primary,#4a6fa5);color:white;border:none;padding:0.4rem 0.8rem;border-radius:6px;font-size:0.85rem;">
            <i class="fas fa-user"></i> Ver Perfil
          </button>
        </td>
      </tr>
    `;
  });
}

function renderUserLeague(user) {
  const leagueInfoSection = document.querySelector('.league-info');
  
  // Si no hay usuario, ocultar toda la sección
  if (!user) {
    leagueInfoSection.style.display = 'none';
    return;
  }
  
  // Si hay usuario, mostrar la sección
  leagueInfoSection.style.display = 'block';
  
  const userPhoto = document.getElementById('user-photo');
  const userName = document.getElementById('user-name');
  const userLeague = document.getElementById('user-league');
  const progressBar = document.querySelector('.progress-bar');
  const progressLabel = document.getElementById('progress-label');
  const userProgress = document.getElementById('user-progress');

  if (!userPhoto || !userName || !userLeague || !progressBar || !progressLabel || !userProgress) return;

  const points = user.impact_points ?? 0;
  const weeklyPoints = user.weekly_points ?? 0;
  
  // Usar liga actual del usuario o calcular por puntos
  const league = user.current_league 
    ? getLeagueByLevel(user.current_league)
    : getLeague(points);
    
  const avatar = user.photo_url || '/img/avatar-default.jpg';
  const name = user.username ?? 'Usuario';

  userPhoto.src = avatar;
  userName.textContent = name;

  // Liga visual con puntos actuales
  let leagueClass = league.name.toLowerCase();
  userLeague.textContent = `Liga ${league.name} | ${points} pts`;
  userLeague.className = `user-league-badge ${leagueClass}`;

  // Barra de progreso para siguiente liga
  const nextLeagueLevel = league.level + 1;
  const nextLeague = getLeagueByLevel(nextLeagueLevel);
  
  if (nextLeague && nextLeague.level > league.level) {
    // Límites correctos de las ligas
    const currentMin = league.level === 1 ? 0 : 
                       league.level === 2 ? 1000 :
                       league.level === 3 ? 2000 :
                       league.level === 4 ? 3000 : 5000;
    
    const nextMin = nextLeague.level === 2 ? 1000 : 
                   nextLeague.level === 3 ? 2000 :
                   nextLeague.level === 4 ? 3000 :
                   nextLeague.level === 5 ? 5000 : 5000;
    
    const progress = Math.min(100, ((points - currentMin) / (nextMin - currentMin)) * 100);
    progressBar.style.width = `${Math.max(0, progress)}%`;
    progressLabel.textContent = `${Math.round(progress)}%`;
    
    const pointsNeeded = Math.max(0, nextMin - points);
    userProgress.innerHTML = `Te faltan <strong>${pointsNeeded.toLocaleString()}</strong> puntos para ascender a Liga ${nextLeague.name}.<br><small>Puntos esta semana: <strong>${weeklyPoints.toLocaleString()}</strong></small>`;
  } else {
    progressBar.style.width = '100%';
    progressLabel.textContent = '¡MÁXIMO!';
    userProgress.innerHTML = `¡Estás en la liga más alta! Sigue ayudando para mantener tu posición.<br><small>Puntos esta semana: <strong>${weeklyPoints.toLocaleString()}</strong></small>`;
  }
}

// También actualizar la función de obtener usuario actual
async function fetchCurrentUser() {
  const { data: { user }, error } = await supabase.auth.getUser();
  if (error || !user) return null;

  const { data: profile, error: profileError } = await supabase
    .from('profiles')
    .select('id, username, photo_url, impact_points, weekly_points, actions_count')
    .eq('id', user.id)
    .single();

  return profileError ? null : profile;
}

async function fetchCommunitiesRanking() {
  try {
    // Consulta actualizada con los puntos calculados automáticamente
    let { data: communities, error } = await supabase
      .from('teams')
      .select(`
        id, 
        name, 
        photo_url, 
        impact, 
        beneficiaries,
        members_count:team_members(count)
      `)
      .order('impact', { ascending: false })
      .limit(50);

    if (error) {
      console.error('Error cargando comunidades:', error.message, error.details);
      return [];
    }

    // Procesar datos para obtener el count real de miembros
    const processedCommunities = communities?.map(community => ({
      ...community,
      members_count: community.members_count?.[0]?.count || 0
    })) || [];

    console.log('🏘️ Datos comunidades:', processedCommunities);
    return processedCommunities;
  } catch (error) {
    console.error('Error fetching communities:', error);
    return [];
  }
}

function renderCommunitiesRanking(communities) {
  const tbody = document.getElementById('communities-ranking');
  tbody.innerHTML = '';
  
  if (!Array.isArray(communities) || communities.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="5" style="text-align:center;color:#888;padding:2rem;">
          <i class="fas fa-users" style="font-size:2rem;margin-bottom:0.5rem;display:block;"></i>
          Aún no hay comunidades registradas.<br>
          <small>¡Sé el primero en crear una!</small>
        </td>
      </tr>`;
    return;
  }
  
  communities.forEach((community, index) => {
    const points = community.impact || 0;
    const name = community.name || 'Comunidad';
    const avatar = community.photo_url || '/img/community-default.jpg';
    const beneficiaries = community.beneficiaries || 0;
    const members = community.members_count || 0;
    
    // Calcular puntos desglosados para mostrar en tooltip
    const memberPoints = members * 20;
    const beneficiaryPoints = beneficiaries * 1;
    const totalCalculated = memberPoints + beneficiaryPoints;
    
    tbody.innerHTML += `
      <tr>
        <td>
          <span class="rank${index < 3 ? ` rank-${index + 1}` : ''}">${index + 1}</span>
        </td>
        <td>
          <div class="user-cell">
            <img src="${avatar}" class="team-avatar-sm" alt="Avatar" 
                 onerror="this.src='/img/community-default.jpg'">
            <div>
              <span>${name}</span>
              <div style="font-size:0.8rem;color:#666;">
                ${members} miembros | ${beneficiarios} beneficiarios
              </div>
            </div>
          </div>
        </td>
        <td class="score" title="Miembros: ${memberPoints} pts | Beneficiarios: ${beneficiaryPoints} pts">
          ${points.toLocaleString()}
        </td>
        <td>${beneficiaries.toLocaleString()}</td>
        <td>
          <button class="btn btn-sm btn-primary" onclick="window.location.href='/teams/${community.id}'" 
                  style="background:var(--primary,#4a6fa5);color:white;border:none;padding:0.4rem 0.8rem;border-radius:6px;font-size:0.85rem;">
            <i class="fas fa-users"></i> Ver Comunidad
          </button>
        </td>
      </tr>
    `;
  });
}

document.addEventListener('DOMContentLoaded', async function() {
  const currentUser = await fetchCurrentUser();
  const currentUserId = currentUser?.id;
  const { usersHistorico, usersDinamico } = await fetchRankingData();
  
  // ✅ Cargar comunidades siempre
  const communities = await fetchCommunitiesRanking();
  
  renderIndividualRanking(usersHistorico, "historico", currentUserId);
  renderUserLeague(currentUser);

  // ✅ TABS DE RANKING
  document.querySelectorAll('.ranking-tab').forEach(tab => {
    tab.addEventListener('click', function () {
      document.querySelectorAll('.ranking-tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('individual-table').style.display = 'none';
      document.getElementById('comunidades-table').style.display = 'none';
      document.getElementById('subranking-tabs').style.display = 'none';

      const tabType = this.getAttribute('data-tab');
      if (tabType === "individual") {
        document.getElementById('individual-table').style.display = '';
        document.getElementById('subranking-tabs').style.display = 'block';
      }
      if (tabType === "comunidades") {
        document.getElementById('comunidades-table').style.display = '';
        // ✅ Siempre renderizar comunidades al hacer clic en la pestaña
        renderCommunitiesRanking(communities);
      }
    });
  });

  // ✅ SUBTABS
  document.querySelectorAll('.subranking-tab').forEach(tab => {
    tab.addEventListener('click', function() {
      document.querySelector('.subranking-tab.active').classList.remove('active');
      this.classList.add('active');
      const type = this.getAttribute('data-type');
      if (type === "dinamico") {
        document.getElementById('ranking-info').innerHTML = `
          <b>Ranking dinámico:</b> Se reinicia cada semana. Sube o baja de liga según tu puntuación semanal.<br>
          Los 10 mejores de cada liga ascienden, los 10 últimos descienden. ¡Sigue sumando puntos para subir!
        `;
        renderIndividualRanking(usersDinamico, "dinamico", currentUserId);
      } else {
        document.getElementById('ranking-info').innerHTML = `
          <b>Ranking histórico:</b> Acumula todos los puntos de impacto desde que te registraste.<br>
          ¡Compite por estar en el top histórico de Solidarity!
        `;
        renderIndividualRanking(usersHistorico, "historico", currentUserId);
      }
    });
  });

  // Modal sistema de puntuación
  const openBtn = document.getElementById('open-score-system');
  const closeBtn = document.getElementById('close-score-system');
  const modal = document.getElementById('score-system-modal');
  if (openBtn && closeBtn && modal) {
    openBtn.addEventListener('click', function() {
      modal.classList.add('active');
      modal.style.display = 'flex';
    });
    closeBtn.addEventListener('click', function() {
      modal.classList.remove('active');
      modal.style.display = 'none';
    });
    window.addEventListener('click', function(e) {
      if (e.target === modal) {
        modal.classList.remove('active');
        modal.style.display = 'none';
      }
    });
  }

  // Modal compartir progreso
  const openShareBtn = document.querySelector('.btn-primary');
  const closeShareBtn = document.getElementById('close-share-progress');
  const shareModal = document.getElementById('share-progress-modal');
  if (openShareBtn && closeShareBtn && shareModal) {
    openShareBtn.addEventListener('click', function() {
      // Llenar datos del usuario en el modal de compartir
      const userName = document.getElementById('user-name').textContent;
      const userPoints = document.getElementById('user-progress').textContent;
      const userAvatar = document.getElementById('user-photo').src;
      
      document.getElementById('share-user-name').textContent = userName;
      document.getElementById('share-points').textContent = userPoints;
      document.getElementById('share-user-avatar').src = userAvatar;
      
      shareModal.classList.add('active');
      shareModal.style.display = 'flex';
    });
    closeShareBtn.addEventListener('click', function() {
      shareModal.classList.remove('active');
      shareModal.style.display = 'none';
    });
    window.addEventListener('click', function(e) {
      if (e.target === shareModal) {
        shareModal.classList.remove('active');
        shareModal.style.display = 'none';
      }
    });
  }

  // Modal perfil detallado (al hacer clic en "Ver Perfil" en la tabla)
  document.getElementById('individual-table').addEventListener('click', async function(e) {
    if (!e.target.closest('tr')) return;
    const row = e.target.closest('tr');
    const userId = row.getAttribute('data-user-id');
    if (!userId) return;
    
    // Obtener datos del usuario
    const { data: user, error } = await supabase
      .from('profiles')
      .select('id, username, photo_url, impact_points, weekly_points, actions_count, current_league, created_at')
      .eq('id', userId)
      .single();
    
    if (error || !user) {
      console.error('Error cargando datos del usuario:', error.message);
      return;
    }
    
    // Llenar datos en el modal de perfil
    document.getElementById('profile-avatar').src = user.photo_url || '/img/avatar-default.jpg';
    document.getElementById('profile-name').textContent = user.username;
    document.getElementById('profile-points').textContent = user.impact_points.toLocaleString();
    document.getElementById('profile-weekly').textContent = user.weekly_points.toLocaleString();
    
    // Obtener y mostrar liga del usuario
    const userLeague = getLeague(user.impact_points);
    document.getElementById('profile-league-badge').textContent = `Liga ${userLeague.name}`;
    document.getElementById('profile-league-badge').style.backgroundColor = userLeague.color;
    
    // Historial de puntos (últimos 30 días)
    const { data: pointsHistory, error: historyError } = await supabase
      .from('points_history')
      .select('date, points')
      .eq('user_id', userId)
      .order('date', { ascending: false })
      .limit(30);
    
    if (historyError) {
      console.error('Error cargando historial de puntos:', historyError.message);
      return;
    }
    
    const pointsHistoryContainer = document.getElementById('points-history');
    pointsHistoryContainer.innerHTML = '';
    if (!pointsHistory || pointsHistory.length === 0) {
      pointsHistoryContainer.innerHTML = `
        <div style="text-align:center;color:#888;padding:1rem 0;">
          <i class="fas fa-history" style="font-size:2rem;margin-bottom:0.5rem;"></i><br>
          No hay historial de puntos disponible.
        </div>
      `;
    } else {
      pointsHistory.forEach(entry => {
        const date = new Date(entry.date);
        const options = { year: 'numeric', month: 'short', day: 'numeric' };
        const formattedDate = date.toLocaleDateString('es-ES', options);
        
        pointsHistoryContainer.innerHTML += `
          <div style="display:flex;justify-content:space-between;margin-bottom:0.8rem;">
            <div style="color:#333;">${formattedDate}</div>
            <div style="font-weight:600;color:${entry.points > 0 ? '#4CAF50' : '#e74c3c'};">
              ${entry.points > 0 ? '+' : ''}${entry.points.toLocaleString()} pts
            </div>
          </div>
        `;
      });
    }
    
    // Causas apoyadas (últimos 30 días)
    const { data: causesSupported, error: causesError } = await supabase
      .from('causes_supported')
      .select('cause_id, created_at')
      .eq('user_id', userId)
      .order('created_at', { ascending: false })
      .limit(30);
    
    if (causesError) {
      console.error('Error cargando causas apoyadas:', causesError.message);
      return;
    }
    
    const causesSupportedContainer = document.getElementById('causes-supported');
    causesSupportedContainer.innerHTML = '';
    if (!causesSupported || causesSupported.length === 0) {
      causesSupportedContainer.innerHTML = `
        <div style="text-align:center;color:#888;padding:1rem 0;">
          <i class="fas fa-hands-helping" style="font-size:2rem;margin-bottom:0.5rem;"></i><br>
          No has apoyado ninguna causa aún.
        </div>
      `;
    } else {
      // Obtener detalles de las causas (batch request para optimizar)
      const causeIds = causesSupported.map(cs => cs.cause_id);
      const { data: causesDetails, error: detailsError } = await supabase
        .from('causes')
        .select('id, title, impact_points')
        .in('id', causeIds);
      
      if (detailsError) {
        console.error('Error cargando detalles de causas:', detailsError.message);
        return;
      }
      
      // Unir datos de causas apoyadas con detalles de causas
      const supportedWithDetails = causesSupported.map(cs => {
        const detail = causesDetails.find(cd => cd.id === cs.cause_id);
        return {
          ...cs,
          title: detail?.title || 'Causa desconocida',
          impact_points: detail?.impact_points || 0
        };
      });
      
      supportedWithDetails.forEach(cause => {
        causesSupportedContainer.innerHTML += `
          <div style="display:flex;justify-content:space-between;margin-bottom:0.8rem;">
            <div style="color:#333;">${cause.title}</div>
            <div style="font-weight:600;color:#4CAF50;">
              +${cause.impact_points.toLocaleString()} pts
            </div>
          </div>
        `;
      });
    }
    
    // Mostrar modal de perfil
    const profileModal = document.getElementById('profile-detail-modal');
    profileModal.classList.add('active');
    profileModal.style.display = 'flex';
  });
});

async function showLeague(leagueNumber) {
  document.querySelectorAll('.league-card').forEach(card => {
    card.classList.remove('active');
  });
  const selectedLeague = document.querySelector(`.league-card.league-${leagueNumber}`);
  if (selectedLeague) {
    selectedLeague.classList.add('active');
  }
  const leagueLevel = leagueNumber;
  const leagueName = selectedLeague.querySelector('h3').innerText;
  const leagueIcon = selectedLeague.querySelector('.league-icon').classList.value;
  const leagueColor = getComputedStyle(selectedLeague).getPropertyValue('border-color');
  
  // Actualizar tabla individual con la liga seleccionada
  const currentUser = await fetchCurrentUser();
  const currentUserId = currentUser?.id;
  const { usersHistorico, usersDinamico } = await fetchRankingData();
  renderIndividualRanking(usersHistorico, "historico", currentUserId, leagueLevel);

  // ACTUALIZAR PROGRESO PERSONAL SI HAY USUARIO
  renderUserLeague(currentUser);

  // Scroll suave a la tabla
  document.getElementById('individual-table').scrollIntoView({ behavior: 'smooth' });
}

// Agregar al final del script de ranking.njk:

function showUserProfile(identifier, username, avatar, points) {
  // Crear modal elegante
  const modal = document.createElement('div');
  modal.style.cssText = `
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;
    z-index: 10000; animation: fadeIn 0.3s ease;
  `;
  
  modal.innerHTML = `
    <div style="background: white; border-radius: 16px; padding: 2rem; max-width: 400px; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
      <img src="${avatar}" style="width: 80px; height: 80px; border-radius: 50%; margin-bottom: 1rem; border: 3px solid #4a6fa5;">
      <h3 style="color: #4a6fa5; margin-bottom: 0.5rem;">@${username}</h3>
      <p style="color: #666; margin-bottom: 1.5rem;">${points.toLocaleString()} puntos de impacto</p>
      <div style="display: flex; gap: 1rem; justify-content: center;">
        <button onclick="window.location.href='/profile/' + (user.username || user.id)" 
                style="background: #4a6fa5; color: white; border: none; padding: 0.7rem 1.5rem; border-radius: 8px; cursor: pointer; font-weight: 600;">
          <i class="fas fa-user"></i> Ver perfil completo
        </button>
        <button onclick="this.closest('[style*=position]').remove()" 
                style="background: #e2e8f0; color: #4a6fa5; border: none; padding: 0.7rem 1rem; border-radius: 8px; cursor: pointer;">
          Cerrar
        </button>
      </div>
    </div>
  `;
  
  document.body.appendChild(modal);
  
  // Cerrar al hacer clic fuera
  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.remove();
  });
}

