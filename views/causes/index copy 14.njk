    .cause-content { padding: 0.7rem; }
    .cause-content h3 { font-size: 1.05rem; }
    .cause-content p { font-size: 0.93rem; }
    .cause-meta { gap: 0.5rem; font-size: 0.82rem; }
    .beneficiaries-count { font-size: 0.82rem; }
    .cause-actions { flex-direction: column; gap: 0.5rem; }
    .btn, .btn-accent, .btn-primary, .btn-outline { font-size: 0.97rem; padding: 0.6rem 0.7rem; }
    .pagination { gap: 0.3rem; }
    .pagination .btn { font-size: 0.97rem; min-width: 32px; height: 32px; }
    .modal-content { padding: 1rem 0.3rem; border-radius: 10px; }
    .modal-cause-header { flex-direction: column; gap: 0.7rem; }
