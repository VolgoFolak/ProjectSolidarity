{% block scripts %}
{{ super() }}

<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
<script src="/js/compartir.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
let currentPage = 1;
let pageSize = 12;
let totalPages = 1;
let currentFilter = "all";
let currentSearch = "";
let currentUser = null;

// ✅ Inicialización principal
document.addEventListener('DOMContentLoaded', async () => {
  console.log('🚀 Inicializando página de causas...');
  
  // Verificar sesión y cargar usuario
  currentUser = await checkUserSession();
  
  // Inicializar eventos
  initializeEventListeners();
  
  // Manejar parámetros URL (Stripe success)
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('stripe') === 'success') {
    await handleStripeSuccess();
  }

  // Cargar causas
  await loadCauses();
  
  // Configurar vista previa de imagen
  setupImagePreview();
  
  // Configurar formulario de crear causa
  setupCreateCauseForm();
});

async function checkUserSession() {
  try {
    const response = await fetch('/me', {
      method: 'GET',
      credentials: 'include'
    });
    
       
    
    if (!response.ok) {
      console.warn('⚠️ Usuario no logueado');
      return { logged: false };
    }
    
    const data = await response.json();
    console.log('✅ Usuario logueado:', data.user?.email);
    return data;
  } catch (error) {
    console.warn('⚠️ Error verificando sesión:', error);
    return { logged: false };
  }
}

function initializeEventListeners() {
  // Botón crear causa - NUEVO FLUJO CON MODAL DE SELECCIÓN
  const createBtn = document.getElementById('create-cause-btn');
  if (createBtn) {
    createBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      await handleCreateCauseClick();
    });
  }

  // Paginación
  const prevBtn = document.getElementById('prevPage');
  const nextBtn = document.getElementById('nextPage');
  
  if (prevBtn) {
    prevBtn.onclick = () => {
      if (currentPage > 1) loadCauses(currentPage - 1, currentFilter, currentSearch);
    };
  }
  
  if (nextBtn) {
    nextBtn.onclick = () => {
      if (currentPage < totalPages) loadCauses(currentPage + 1, currentFilter, currentSearch);
    };
  }

  // Filtros
  document.querySelectorAll('.tab').forEach(tab => {
    tab.onclick = () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentFilter = tab.getAttribute('data-filter');
      loadCauses(1, currentFilter, currentSearch);
    };
  });

  // Búsqueda con debounce
  const searchInput = document.getElementById('search-input');
  if (searchInput) {
    let searchTimeout;
    searchInput.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        currentSearch = e.target.value;
        loadCauses(1, currentFilter, currentSearch);
      }, 300);
    });
  }

  // Cerrar modales
  setupModalHandlers();
  
  // Configurar modales de donación
  setupDonationMethodHandlers();
  
  // Configurar modales de Stripe
  setupStripeModals();
}

// ✅ NUEVO: Flujo principal de crear causa
async function handleCreateCauseClick() {
  try {
    console.log('🎯 Iniciando flujo de crear causa...');
    
    // 1. Verificar usuario
    if (!currentUser || !currentUser.logged) {
      console.log('❌ Usuario no logueado');
      showLoginModal();
      return;
    }

    console.log('✅ Usuario verificado, mostrando modal de selección de donación');
    
    // 2. Mostrar modal de selección de método de donación
    showDonationMethodModal();
    
  } catch (error) {
    console.error('❌ Error en handleCreateCauseClick:', error);
    showNotification('Error al iniciar creación de causa', 'error');
  }
}

// ✅ NUEVO: Mostrar modal de selección de método de donación
function showDonationMethodModal() {
  const modal = document.getElementById('donationMethodModal');
  if (modal) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    console.log('📋 Mostrando modal de selección de donación');
  }
}

// ✅ NUEVO: Configurar handlers para los métodos de donación
function setupDonationMethodHandlers() {
  const modal = document.getElementById('donationMethodModal');
  const closeBtn = document.getElementById('closeDonationMethodModal');
  const stripeOption = document.getElementById('stripeOption');
  const otherMethodsOption = document.getElementById('otherMethodsOption');

  // Cerrar modal
  if (closeBtn) {
    closeBtn.onclick = () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    };
  }

  // Opción Stripe
  if (stripeOption) {
    stripeOption.onclick = async () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
      console.log('💳 Usuario eligió Stripe');
      await handleStripeOption();
    };
  }

  // Otros métodos
  if (otherMethodsOption) {
    otherMethodsOption.onclick = () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
      console.log('💰 Usuario eligió otros métodos');
      showCreateCauseModal(false); // false = sin Stripe
    };
  }

  // Cerrar al hacer clic fuera
  if (modal) {
    modal.onclick = (e) => {
      if (e.target === e.currentTarget) {
        e.currentTarget.classList.remove('active');
        document.body.style.overflow = '';
      }
    };
  }
}

// ✅ NUEVO: Manejar opción Stripe
async function handleStripeOption() {
  try {
    console.log('🔍 Verificando estado de Stripe...');
    
    // Verificar estado de Stripe
    const stripeResponse = await fetch(`/api/stripe/status?userId=${currentUser.user.id}`, {
      credentials: 'include'
    });
    
    if (!stripeResponse.ok) {
      throw new Error('Error verificando estado de Stripe');
    }
    
    const stripeData = await stripeResponse.json();
    console.log('📊 Estado Stripe:', stripeData);
    
    if (stripeData.isActive) {
      // Stripe ya está activo
      console.log('✅ Stripe activo, mostrando modal de crear causa');
      showCreateCauseModal(true); // true = con Stripe
    } else {
      // Necesita configurar Stripe
      console.log('⚠️ Stripe no activo, mostrando modal de configuración');
      showStripeSetupModal();
    }
  } catch (error) {
    console.error('❌ Error verificando Stripe:', error);
    showNotification('Error verificando cuenta de pagos', 'error');
  }
}

// ✅ NUEVO: Mostrar modal de configuración Stripe
function showStripeSetupModal() {
  const modal = document.getElementById('stripeSetupModal');
  if (modal) {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    console.log('🔧 Mostrando modal de configuración Stripe');
  }
}

// ✅ NUEVO: Configurar modales de Stripe
function setupStripeModals() {
  // Modal de configuración Stripe
  const setupModal = document.getElementById('stripeSetupModal');
  const connectBtn = document.getElementById('connectStripeBtn');
  const cancelSetupBtn = document.getElementById('cancelStripeSetupBtn');

  if (connectBtn) {
    connectBtn.onclick = async (e) => {
      e.preventDefault();
      await redirectToStripeOnboarding();
    };
  }

  if (cancelSetupBtn) {
    cancelSetupBtn.onclick = () => {
      setupModal.style.display = 'none';
      document.body.style.overflow = '';
      // Volver al modal de selección de método
      showDonationMethodModal();
    };
  }

  // Modal de éxito Stripe
  const successModal = document.getElementById('stripeSuccessModal');
  const closeSuccessBtn = document.getElementById('closeStripeSuccessModal');
  const createNowBtn = document.getElementById('createCauseNow');
  const dashboardBtn = document.getElementById('viewDashboard');

  if (closeSuccessBtn) {
    closeSuccessBtn.onclick = () => {
      successModal.classList.remove('active');
      document.body.style.overflow = '';
    };
  }

  if (createNowBtn) {
    createNowBtn.onclick = () => {
      successModal.classList.remove('active');
      showCreateCauseModal(true); // Con Stripe activo
    };
  }

  if (dashboardBtn) {
    dashboardBtn.onclick = async () => {
      try {
        const res = await fetch('/api/stripe/dashboard-link', {
          credentials: 'include'
        });
        if (res.ok) {
          const { url } = await res.json();
          window.open(url, '_blank');
        }
      } catch (error) {
        console.error('Error obteniendo enlace del dashboard:', error);
        showNotification('Error accediendo al dashboard', 'error');
      }
    };
  }
}

// ✅ NUEVO: Mostrar modal de crear causa
function showCreateCauseModal(withStripe = false) {
  const modal = document.getElementById('createCauseModal');
  if (modal) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    
    // Configurar formulario según si tiene Stripe o no
    const howToDonateField = document.getElementById('how_to_donate');
    const bankAccountField = document.getElementById('bank_account');
    
    if (withStripe) {
      console.log('✅ Modal de crear causa con Stripe activo');
      if (howToDonateField) {
        howToDonateField.value = 'Las donaciones se procesan automáticamente a través de Stripe y se depositan directamente en tu cuenta bancaria.';
        howToDonateField.disabled = true;
      }
      if (bankAccountField) {
        bankAccountField.style.display = 'none';
      }
    } else {
      console.log('📝 Modal de crear causa sin Stripe');
      if (howToDonateField) {
        howToDonateField.disabled = false;
        howToDonateField.placeholder = 'Ej: Puedes donar por Bizum al 600123456, transferencia bancaria a ES12 1234 5678 9012 3456 7890, o PayPal a mi@email.com';
      }
      if (bankAccountField) {
        bankAccountField.style.display = 'block';
      }
    }
  }
}

// ✅ MEJORADO: Redirección a onboarding Stripe
async function redirectToStripeOnboarding() {
  try {
    console.log('🔄 Iniciando onboarding de Stripe...');
    
    showNotification('Redirigiendo a configuración de Stripe...', 'info');
    
    const response = await fetch('/api/stripe/create-account', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({
        email: currentUser.user.email,
        userId: currentUser.user.id,
        causeData: { 
          title: 'Nueva causa solidaria',
          type: 'onboarding'
        }
      })
    });

    if (!response.ok) {
      const errorData = await response.json();
      throw new Error(errorData.error || 'Error creando cuenta Stripe');
    }

    const { returnUrl, accountId } = await response.json();
    console.log('➡️ Redirigiendo a onboarding:', returnUrl);
    
    // Guardar estado antes de redirección
    localStorage.setItem('pendingCauseCreation', 'true');
    localStorage.setItem('stripeAccountId', accountId);
    
    // Cerrar modal antes de redireccionar
    document.getElementById('stripeSetupModal').style.display = 'none';
    document.body.style.overflow = '';
    
    // Redireccionar
    window.location.href = returnUrl;
    
  } catch (error) {
    console.error('❌ Error en onboarding Stripe:', error);
    showNotification('Error configurando pagos. Intenta de nuevo.', 'error');
  }
}

// ✅ MEJORADO: Manejar éxito de Stripe
async function handleStripeSuccess() {
  try {
    console.log('🎉 Procesando éxito de Stripe...');
    
    // Verificar sesión actualizada
    currentUser = await checkUserSession();
    
    if (!currentUser.logged) {
      console.log('❌ Usuario no logueado después de Stripe');
      window.location.href = '/login?return=/causes?stripe=success';
      return;
    }

    // Esperar un momento para que el webhook procese
    await new Promise(resolve => setTimeout(resolve, 2000));

    // Verificar estado final de Stripe
    const stripeResponse = await fetch(`/api/stripe/status?userId=${currentUser.user.id}`, {
      credentials: 'include'
    });
    
    if (stripeResponse.ok) {
      const { isActive, accountData } = await stripeResponse.json();
      console.log('📊 Estado final Stripe:', { isActive, accountData });
      
      if (isActive) {
        showStripeSuccessModal();
        localStorage.removeItem('pendingCauseCreation');
        localStorage.removeItem('stripeAccountId');
      } else {
        showNotification('Configuración de Stripe pendiente. Completa el proceso desde tu email.', 'warning');
      }
    } else {
      showNotification('Error verificando estado de Stripe', 'error');
    }

    // Limpiar URL
    window.history.replaceState({}, '', '/causes');
    
  } catch (error) {
    console.error('❌ Error procesando éxito de Stripe:', error);
    showNotification('Error procesando configuración de Stripe', 'error');
  }
}

// ✅ NUEVO: Mostrar modal de éxito de Stripe
function showStripeSuccessModal() {
  const modal = document.getElementById('stripeSuccessModal');
  if (modal) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    console.log('🎉 Mostrando modal de éxito de Stripe');
    
    // Mostrar notificación adicional
    setTimeout(() => {
      showNotification('¡Cuenta Stripe conectada exitosamente!', 'success');
    }, 500);
  }
}

// ✅ NUEVO: Configurar vista previa de imagen
function setupImagePreview() {
  const photoInput = document.getElementById('photo');
  const previewImg = document.getElementById('previewImg');
  
  if (photoInput && previewImg) {
    photoInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          previewImg.src = e.target.result;
          previewImg.style.display = 'block';
        };
        reader.readAsDataURL(file);
      } else {
        previewImg.style.display = 'none';
      }
    });
  }
}

// ✅ NUEVO: Configurar formulario de crear causa
function setupCreateCauseForm() {
  const form = document.getElementById('causeForm');
  const pointsInput = document.getElementById('points');
  const pointsText = document.getElementById('pointsText');
  
  // Actualizar texto de puntos dinámicamente
  if (pointsInput && pointsText) {
    pointsInput.addEventListener('input', function() {
      const points = this.value || 50;
      pointsText.innerHTML = `
        <i class="fas fa-star"></i>
        Colaborar en esta causa otorgará <strong>${points} puntos</strong> a cada participante.
      `;
    });
  }
  
  // Manejar envío del formulario
  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      await handleCreateCauseSubmit(this);
    });
  }
}

// ✅ NUEVO: Manejar envío de formulario
async function handleCreateCauseSubmit(form) {
  try {
    console.log('📤 Enviando formulario de crear causa...');
    
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    
    // Deshabilitar botón
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creando...';
    
    // Recopilar datos del formulario
    const formData = new FormData(form);
    
    // Añadir datos del usuario
    formData.append('user_id', currentUser.user.id);
    formData.append('user_email', currentUser.user.email);
    
    // Verificar si tiene Stripe activo
    const stripeResponse = await fetch(`/api/stripe/status?userId=${currentUser.user.id}`, {
      credentials: 'include'
    });
    
    let hasStripe = false;
    if (stripeResponse.ok) {
      const stripeData = await stripeResponse.json();
      hasStripe = stripeData.isActive;
      if (hasStripe) {
        formData.append('stripe_account_id', stripeData.accountData?.id || '');
      }
    }
    
    // Enviar al backend
    const response = await fetch('/api/causes/create', {
      method: 'POST',
      credentials: 'include',
      body: formData
    });
    
    if (!response.ok) {
      const errorData = await response.json();
      throw new Error(errorData.error || 'Error creando causa');
    }
    
    const result = await response.json();
    console.log('✅ Causa creada:', result);
    
    // Mostrar éxito
    showNotification('¡Causa creada exitosamente!', 'success');
    
    // Mostrar sección después de crear
    form.style.display = 'none';
    document.getElementById('afterCreate').style.display = 'block';
    
    // Recargar causas
    setTimeout(() => {
      loadCauses();
    }, 1000);
    
  } catch (error) {
    console.error('❌ Error creando causa:', error);
    showNotification(`Error: ${error.message}`, 'error');
  } finally {
    // Rehabilitar botón
    const submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Crear Causa';
  }
}

// ✅ MEJORADO: Configurar handlers de modales
function setupModalHandlers() {
  // Modal crear causa
  const closeCreateBtn = document.getElementById('closeCreateCauseModal');
  const createModal = document.getElementById('createCauseModal');
  
  if (closeCreateBtn) {
    closeCreateBtn.onclick = () => {
      createModal.classList.remove('active');
      document.body.style.overflow = '';
      // Resetear formulario
      const form = document.getElementById('causeForm');
      if (form) {
        form.reset();
        form.style.display = 'block';
        document.getElementById('afterCreate').style.display = 'none';
        document.getElementById('previewImg').style.display = 'none';
      }
    };
  }

  if (createModal) {
    createModal.onclick = (e) => {
      if (e.target === e.currentTarget) {
        e.currentTarget.classList.remove('active');
        document.body.style.overflow = '';
      }
    };
  }

  // Modal de login
  const loginModal = document.getElementById('loginModal');
  const closeLoginBtn = document.getElementById('closeLoginModal');
  const cancelLoginBtn = document.getElementById('cancelLoginModal');
  
  const closeLogin = () => {
    loginModal.classList.remove('active');
    document.body.style.overflow = '';
  };
  
  if (closeLoginBtn) closeLoginBtn.onclick = closeLogin;
  if (cancelLoginBtn) cancelLoginBtn.onclick = closeLogin;
  
  if (loginModal) {
    loginModal.onclick = (e) => {
      if (e.target === e.currentTarget) closeLogin();
    };
  }
}

function showLoginModal() {
  const modal = document.getElementById('loginModal');
  if (modal) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    console.log('🔐 Mostrando modal de login');
  }
}

// ✅ MEJORADO: Cargar causas
async function loadCauses(page = 1, filter = "all", search = "") {
  try {
    console.log(`📖 Cargando causas - Página: ${page}, Filtro: ${filter}`);
    
    // Construir URL de API
    let apiUrl = `/api/causes?page=${page}&limit=${pageSize}`;
    if (filter !== "all") apiUrl += `&category=${filter}`;
    if (search && search.trim() !== "") apiUrl += `&search=${encodeURIComponent(search)}`;

    const response = await fetch(apiUrl, {
      credentials: 'include'
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}: ${response.statusText}`);
    }

    const responseData = await response.json();
    const causes = responseData.data || responseData || [];
    const total = responseData.total || causes.length;
    
    totalPages = Math.max(1, Math.ceil(total / pageSize));
    currentPage = page;

    // Renderizar causas
    const container = document.getElementById('causesList');
    if (container) {
      if (window.causesRenderer && typeof window.causesRenderer.renderGrid === 'function') {
        window.causesRenderer.renderGrid(causes, container);
      } else {
        // Fallback mejorado
        if (causes.length > 0) {
          container.innerHTML = causes.map(cause => createCauseCardHTML(cause)).join('');
        } else {
          container.innerHTML = `
            <div style="grid-column: 1/-1; text-align: center; padding: 3rem;">
              <i class="fas fa-seedling" style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;"></i>
              <h3 style="color: #666; margin-bottom: 0.5rem;">No hay causas disponibles</h3>
              <p style="color: #999;">¡Sé el primero en crear una causa solidaria!</p>
            </div>
          `;
        }
      }
    }

    updatePagination();
    console.log(`✅ Causas cargadas: ${causes.length}/${total}`);
    
    // Guardar causas en variable global para acceso rápido
    window.lastLoadedCauses = causes;
    
  } catch (error) {
    console.error('❌ Error cargando causas:', error);
    const container = document.getElementById('causesList');
    if (container) {
      container.innerHTML = `
        <div style="grid-column: 1/-1; text-align: center; padding: 3rem;">
          <i class="fas fa-exclamation-triangle" style="font-size: 3rem; color: #e53e3e; margin-bottom: 1rem;"></i>
          <h3 style="color: #e53e3e; margin-bottom: 1rem;">Error cargando causas</h3>
          <p style="color: #666; margin-bottom: 2rem;">${error.message}</p>
          <button onclick="loadCauses()" class="btn btn-primary">
            <i class="fas fa-redo"></i> Reintentar
          </button>
        </div>
      `;
    }
  }
}

function updatePagination() {
  const prevBtn = document.getElementById('prevPage');
  const nextBtn = document.getElementById('nextPage');
  const pageInfo = document.getElementById('pageInfo');

  if (prevBtn) {
    prevBtn.disabled = currentPage <= 1;
  }
  if (nextBtn) {
    nextBtn.disabled = currentPage >= totalPages;
  }
  if (pageInfo) {
    pageInfo.textContent = `${currentPage} / ${totalPages}`;
  }
}

// ✅ NUEVO: Crear HTML de tarjeta de causa
function createCauseCardHTML(cause) {
  const progressPercent = cause.goal > 0 ? Math.min((cause.raised || 0) / cause.goal * 100, 100) : 0;
  const imageUrl = cause.photo_url || '/images/default-cause.jpg';

  // Detectar Stripe
  const hasStripe = !!cause.stripe_enabled && !!cause.stripe_account_id;

  return `
    <div class="cause-card" data-cause-id="${cause.id}">
      <div class="cause-image">
        <img src="${imageUrl}" alt="${cause.title}" loading="lazy">
        ${cause.is_urgent ? '<div class="cause-badge urgent"><i class="fas fa-exclamation"></i> Urgente</div>' : ''}
        <div class="cause-badge points"><i class="fas fa-star"></i> ${cause.points || 50}</div>
      </div>
      <div class="cause-content">
        <h3>${cause.title}</h3>
        <p>${cause.short_description || cause.description?.substring(0, 120) + '...' || 'Sin descripción'}</p>
        <div class="cause-meta">
          <div class="meta-item">
            <i class="fas fa-map-marker-alt"></i>
            <span>${cause.city}, ${cause.country}</span>
          </div>
          <div class="meta-item">
            <i class="fas fa-calendar"></i>
            <span>${new Date(cause.created_at).toLocaleDateString()}</span>
          </div>
        </div>
        <div class="beneficiaries-count">
          <i class="fas fa-users"></i>
          ${cause.beneficiaries} beneficiarios
        </div>
        <div class="cause-progress">
          <div class="progress-bar">
            <div class="progress-fill" style="width: ${progressPercent}%"></div>
          </div>
          <div class="progress-info">
            <span>${progressPercent.toFixed(0)}% alcanzado</span>
            <span>€${cause.raised || 0} / €${cause.goal}</span>
          </div>
        </div>
        <div class="cause-actions">
          <button onclick="viewCauseDetails('${cause.id}')" class="btn btn-primary">
            Ver más
          </button>
          <button onclick="handleDonateClick('${cause.id}')" class="btn btn-accent">
            Donar
          </button>
        </div>
      </div>
    </div>
  `;
}

// Nueva función para manejar el click en "Donar"
function handleDonateClick(causeId) {
  // Buscar la causa en la lista cargada
  const cause = window.lastLoadedCauses?.find(c => c.id == causeId);
  if (!cause) return showNotification('Causa no encontrada', 'error');

  // Si tiene Stripe activo, mostrar modal Stripe
  if (cause.stripe_enabled && cause.stripe_account_id) {
    showStripeDonationModal(cause);
  } else {
    // Si no, mostrar modal de donación manual
    if (window.causesRenderer && typeof window.causesRenderer.showModal === 'function') {
      window.causesRenderer.showModal(causeId, 'donations');
    } else {
      viewCauseDetails(causeId);
    }
  }
}

function showStripeDonationModal(cause) {
  const modal = document.getElementById('stripeDonationModal');
  if (!modal) return;

  // Rellenar datos
  document.getElementById('stripeDonationTitle').textContent = `Donar a: ${cause.title}`;
  document.getElementById('stripeDonationDesc').textContent = cause.short_description || cause.description?.substring(0,120) || '';
  document.getElementById('stripeDonationAmount').value = 20;
  document.getElementById('stripeDonationExtra').innerHTML = `
    Comisión Stripe: <strong>1.4% + €0.25</strong> por transacción.<br>
    Pagos disponibles en <strong>2-3 días hábiles</strong>.
  `;

  // Mostrar modal
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';

  // Cerrar modal
  document.getElementById('closeStripeDonationModal').onclick = () => {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  };

  // Procesar pago
  document.getElementById('stripePayBtn').onclick = async () => {
    const amount = parseFloat(document.getElementById('stripeDonationAmount').value);
    if (!amount || amount < 1) {
      showNotification('Introduce una cantidad válida', 'warning');
      return;
    }

    // Llamar al backend para crear sesión Stripe
    try {
      const res = await fetch('/api/stripe/create-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          causeId: cause.id,
          amount,
          currency: 'eur'
        })
      });
      if (res.ok) {
        const { url } = await res.json();
        window.location.href = url;
      } else {
        throw new Error('Error procesando donación');
      }
    } catch (err) {
      showNotification('Error procesando donación', 'error');
    }
  };

  // Cerrar al hacer clic fuera
  modal.onclick = (e) => {
    if (e.target === modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  };
}
  </script>
