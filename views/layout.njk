  {% block scripts %}{% endblock %}

  <!-- Notificaciones -->
  <div id="notifications" class="notifications-container"></div>

  <!-- Modal de bienvenida -->
  <div id="welcomeModal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.35); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:18px; max-width:370px; margin:auto; padding:2.2rem 1.7rem; box-shadow:0 8px 32px rgba(0,0,0,0.13); text-align:center;">
      <span style="font-size:2.7rem; color:#2dd4bf; display:block; margin-bottom:1rem;">
        <i class="fas fa-fire"></i>
      </span>
      <h2 style="color:#2dd4bf; font-weight:900; margin-bottom:0.7rem;" data-i18n="welcome.title">¡Bienvenido/a de nuevo!</h2>
      <p style="color:#444; font-size:1.13rem;" data-i18n="welcome.message">
        ¡Nos alegra verte en Solidarity!<br>
        <strong>Hoy es un gran día para ayudar, inspirar y transformar el mundo.</strong>
      </p>
      <p style="color:#888; font-size:0.97rem; margin-top:1em;" data-i18n="welcome.subtitle">
        ¿Listo/a para dejar tu huella positiva?<br>
        ¡Explora, conecta y actúa!
      </p>
      <button onclick="document.getElementById('welcomeModal').style.display='none';" 
              style="margin-top:1.5rem; background:#2dd4bf; color:#fff; border:none; border-radius:8px; padding:0.8rem 1.7rem; font-size:1.1rem; font-weight:700; cursor:pointer;" 
              data-i18n="welcome.button">
        ¡Vamos allá!
      </button>
    </div>
  </div>
  
  <!-- ✅ SCRIPT PARA TRADUCIR AUTOMÁTICAMENTE -->
  <script>
    document.addEventListener('i18nReady', () => {
      translateElements();
    });
    function translateElements() {
      console.log('🌍 Iniciando traducción de elementos...');
      const elementsToTranslate = document.querySelectorAll('[data-i18n]');
      elementsToTranslate.forEach(element => {
        const key = element.getAttribute('data-i18n');
        if (window.t && typeof window.t === 'function') {
          const translation = window.t(key);
          if (translation && translation !== key) {
            element.textContent = translation;
            console.log('✅ Traducido:', key, '->', translation);
          }
        }
      });
      const elementsWithTitle = document.querySelectorAll('[data-i18n-title]');
      elementsWithTitle.forEach(element => {
        const key = element.getAttribute('data-i18n-title');
        if (window.t && typeof window.t === 'function') {
          const translation = window.t(key);
          if (translation && translation !== key) {
            element.setAttribute('title', translation);
          }
        }
      });
    }
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'page_view', {
          page_title: document.title,
          page_location: window.location.href,
          user_type: window.userType || 'anonymous',
          page_section: getCurrentPageSection()
        });
        console.log('📊 Analytics inicializado para:', window.location.pathname);
      }
    });
    function getCurrentPageSection() {
      const path = window.location.pathname;
      if (path.includes('/causes')) return 'causes';
      if (path.includes('/teams')) return 'teams';
      if (path.includes('/challenges')) return 'challenges';
      if (path.includes('/volunteer')) return 'volunteer';
      if (path.includes('/profile')) return 'profile';
      if (path === '/') return 'home';
      return 'other';
    }
    function isTrending(activity) {
      if (activity.type === 'cause') {
        return (activity.beneficiaries || 0) + (activity.raised || 0) > 100;
      }
      if (activity.type === 'task') {
        return (activity.beneficiaries || 0) > 50;
      }
      if (activity.type === 'volunteering') {
        return (activity.volunteers_needed || 0) > 30;
      }
      if (activity.type === 'challenge') {
        const created = new Date(activity.created_at);
        const now = new Date();
        const diffDays = (now - created) / (1000 * 60 * 60 * 24);
        return diffDays < 7;
      }
      return false;
    }
    window.trackSolidarityEvent = function(eventName, parameters = {}) {
      if (typeof gtag !== 'undefined') {
        const enrichedParams = {
          ...parameters,
          user_type: window.userType || 'anonymous',
          timestamp: new Date().toISOString(),
          page_section: getCurrentPageSection(),
          user_language: window.currentLang || 'es'
        };
        gtag('event', eventName, enrichedParams);
        console.log('📊 Evento tracked:', eventName, enrichedParams);
      }
    };
  </script>

  <!-- Scripts antes del cierre del body -->
  <script src="/js/compartir.js"></script>

  <!-- Mobile Navigation Components -->
  <script src="/js/components/mobile-bottom-nav.js"></script>
  <solidarity-bottom-nav></solidarity-bottom-nav>
  <script src="/js/components/mobile-hamburger-menu.js"></script>
  <script src="/js/components/mobile-header.js"></script>
  <script src="/js/components/mobile-avatar.js"></script>
  <solidarity-mobile-header>
    <solidarity-hamburger-menu slot="hamburger"></solidarity-hamburger-menu>
    <solidarity-mobile-avatar slot="avatar"></solidarity-mobile-avatar>
  </solidarity-mobile-header>

  <!-- ✅ ANALYTICS AVANZADO -->
  <script src="/js/analytics.js"></script>
  <script src="/js/auto-translate.js"></script>
  <div id="google_translate_element" style="display:none;"></div>
  <script type="text/javascript">
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({
        pageLanguage: 'es',
        includedLanguages: 'en,es,fr,de,it,pt,ru,zh-CN,ar,ja,ko,hi,tr,pl,nl,sv,da,no,fi,he,th,vi,id,ms,tl,uk,cs,hu,ro,bg,hr,sk,sl,et,lv,lt,mt,el,ca,eu,gl',
        layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
        autoDisplay: false,
        multilanguagePage: true,
        gaTrack: true,
        gaId: 'G-KLTQ612VGL'
      }, 'google_translate_element');
      setTimeout(() => {
        if (window.autoTranslate) window.autoTranslate.init();
      }, 1500);
    }
  </script>
  <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

  <!-- Mejoras de sesión: ping para mantener sesión activa -->
  <script>
    setInterval(() => {
      fetch('/api/check-session', { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
          if (!data.ok) {
            window.location.href = '/login';
          }
        });
    }, 5 * 60 * 1000);
  </script>

  <!-- Stripe onboarding y dashboard helpers -->
  <script>
    window.openStripeDashboard = async function() {
      const res = await fetch('/api/stripe/dashboard-link', { credentials: 'include' });
      const data = await res.json();
      if (data.url) window.open(data.url, '_blank');
      else alert('No tienes cuenta Stripe activa.');
    };
    window.retryStripeOnboarding = async function() {
      window.location.href = '/reauth-stripe';
    };
  </script>
  <!-- Modal de éxito Stripe mejorado -->
<div id="stripeSuccessModal" class="modal-bg">
  <div class="modal-content" style="text-align: center; max-width: 500px;">
    <button class="close-modal" id="closeStripeSuccessModal" style="position:absolute;top:18px;right:18px;font-size:2rem;background:none;border:none;color:#2dd4bf;cursor:pointer;">&times;</button>
    
    <!-- Animación de éxito -->
    <div style="background: linear-gradient(135deg, #4fc3a1, #4a6fa5); width:100px; height:100px; border-radius:50%; margin:0 auto 2rem; display:flex; align-items:center; justify-content:center; box-shadow:0 8px 25px rgba(79,195,161,0.3); animation: pulse 2s infinite;">
      <i class="fas fa-check" style="color:white; font-size:3rem;"></i>
    </div>

    <h2 style="color: #2dd4bf; margin-bottom: 1rem; font-size: 1.8rem;">¡Cuenta conectada con éxito!</h2>
    
    <div id="causeCreatedSection" style="display: none;">
      <p style="margin-bottom: 1.5rem; font-size: 1.1rem; color: #4b5563;">
        ¡Fantástico! Tu causa "<span id="createdCauseTitle" style="color: #4a6fa5; font-weight: 600;"></span>" ha sido creada exitosamente.<br>
        <strong>¡Ya estás listo para recibir donaciones!</strong>
      </p>
      <div style="display: flex; flex-direction: column; gap: 0.8rem; max-width: 300px; margin: 0 auto;">
        <button id="viewCreatedCause" class="btn btn-primary" style="padding: 1rem;">
          <i class="fas fa-eye"></i> Ver mi causa
        </button>
        <button id="shareCause" class="btn btn-accent" style="padding: 1rem;">
          <i class="fas fa-share-alt"></i> Compartir causa
        </button>
      </div>
    </div>

    <div id="noSpecificCauseSection">
      <p style="margin-bottom: 1.5rem; font-size: 1.1rem; color: #4b5563;">
        ¡Perfecto! Ahora puedes recibir donaciones directamente en tu cuenta bancaria.<br>
        <strong>¿Listo para crear tu primera causa solidaria?</strong>
      </p>
      <div style="display: flex; flex-direction: column; gap: 0.8rem; max-width: 300px; margin: 0 auto;">
        <button id="createCauseAfterStripe" class="btn btn-primary" style="padding: 1rem;">
          <i class="fas fa-plus"></i> Crear mi primera causa
        </button>
        <button id="exploreCausesBtn" class="btn btn-outline" style="padding: 1rem;">
          <i class="fas fa-compass"></i> Explorar otras causas
        </button>
      </div>
    </div>

    <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #eee;">
      <p style="font-size: 0.9rem; color: #666;">
        <i class="fas fa-lightbulb"></i> Consejo: Comparte tu causa en redes sociales para llegar a más personas
      </p>
    </div>
  </div>
</div>

<style>
@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.modal-bg {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0,0,0,0.5);
  z-index: 9999;
  align-items: center;
  justify-content: center;
}

.modal-bg.active {
  display: flex;
}

.modal-content {
  background: white;
  border-radius: 16px;
  padding: 2.5rem;
  max-width: 500px;
  width: 90%;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  animation: fadeIn 0.3s ease-out;
  position: relative;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  const urlParams = new URLSearchParams(window.location.search);
  const stripeStatus = urlParams.get('stripe');
  const userId = urlParams.get('user_id');
  const causeId = urlParams.get('cause_id');

  console.log('🔄 Verificando parámetros:', { stripeStatus, userId, causeId });

  // Manejo del éxito de Stripe
  if (stripeStatus === 'success') {
    console.log('✅ Stripe success detectado');

    // Restaurar sesión si es necesario
    if (!window.currentUserId && userId) {
      console.log('🔄 Restaurando sesión...');
      try {
        const response = await fetch('/api/restore-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ user_id: userId })
        });

        if (response.ok) {
          const data = await response.json();
          console.log('✅ Sesión restaurada:', data.user);
          window.currentUserId = data.user.id;
          
          // Actualizar navbar si existe
          if (window.updateNavbar) {
            window.updateNavbar(data.user);
          }
        } else {
          console.error('❌ Error en respuesta de restauración:', response.status);
        }
      } catch (error) {
        console.error('❌ Error restaurando sesión:', error);
      }
    }

    // Mostrar modal de éxito
    const modal = document.getElementById('stripeSuccessModal');
    if (modal) {
      // Si se creó una causa específica
      if (causeId) {
        console.log('🎯 Mostrando éxito con causa específica:', causeId);
        document.getElementById('causeCreatedSection').style.display = 'block';
        document.getElementById('noSpecificCauseSection').style.display = 'none';
        
        // Cargar título de la causa
        try {
          const { data: cause } = await supabase
            .from('causes')
            .select('title')
            .eq('id', causeId)
            .single();
          
          if (cause) {
            document.getElementById('createdCauseTitle').textContent = cause.title;
            
            // Configurar botón para ver causa
            document.getElementById('viewCreatedCause').onclick = () => {
              modal.classList.remove('active');
              document.body.style.overflow = '';
              
              // Usar el renderer si está disponible
              if (window.causesRenderer && window.causesRenderer.showModal) {
                setTimeout(() => {
                  window.causesRenderer.showModal(causeId);
                }, 300);
              } else {
                window.location.href = `/causes/${causeId}`;
              }
            };

            // Configurar botón para compartir
            document.getElementById('shareCause').onclick = () => {
              const shareText = `¡Acabo de crear mi causa "${cause.title}" en Solidarity! 🌟 ¡Ayúdame a transformar vidas! 💚`;
              const shareUrl = `${window.location.origin}/causes/${causeId}`;
              
              if (navigator.share) {
                navigator.share({
                  title: cause.title,
                  text: shareText,
                  url: shareUrl
                });
              } else {
                navigator.clipboard.writeText(shareText + ' ' + shareUrl).then(() => {
                  showNotification('¡Enlace copiado! Compártelo donde quieras', 'success');
                }).catch(() => {
                  // Fallback
                  prompt('Copia este enlace:', shareText + ' ' + shareUrl);
                });
              }
            };
          }
        } catch (error) {
          console.error('Error cargando causa:', error);
          // Mostrar sección general si falla cargar la causa específica
          document.getElementById('causeCreatedSection').style.display = 'none';
          document.getElementById('noSpecificCauseSection').style.display = 'block';
        }
      } else {
        console.log('🎯 Mostrando éxito general');
        document.getElementById('causeCreatedSection').style.display = 'none';
        document.getElementById('noSpecificCauseSection').style.display = 'block';
      }

      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
      
      // Auto-cerrar después de 30 segundos
      setTimeout(() => {
        if (modal.classList.contains('active')) {
          modal.classList.remove('active');
          document.body.style.overflow = '';
        }
      }, 30000);
    }

    // Limpiar URL sin recargar
    const cleanUrl = new URL(window.location);
    cleanUrl.searchParams.delete('stripe');
    cleanUrl.searchParams.delete('user_id');
    cleanUrl.searchParams.delete('cause_id');
    window.history.replaceState({}, '', cleanUrl.toString());
  }

  // Manejo de errores de Stripe
  const stripeError = urlParams.get('stripe_error');
  if (stripeError) {
    console.log('❌ Error de Stripe detectado:', stripeError);
    
    const errorMessages = {
      'refresh': 'Necesitas completar la configuración de Stripe nuevamente.',
      'incomplete': 'La configuración de tu cuenta Stripe está incompleta. Por favor, completa el proceso.',
      'no_user_id': 'Error de sesión. Por favor, inicia sesión nuevamente.',
      'user_not_found': 'Usuario no encontrado. Por favor, inicia sesión nuevamente.',
      'no_stripe_account': 'No se encontró tu cuenta de Stripe. Por favor, intenta configurar nuevamente.',
      'stripe_api_error': 'Error de comunicación con Stripe. Por favor, intenta más tarde.',
      'callback_failed': 'Error en el proceso de verificación. Por favor, intenta nuevamente.'
    };

    const message = errorMessages[stripeError] || 'Error desconocido en la configuración de Stripe.';
    
    if (window.showNotification) {
      window.showNotification(message, 'error', 8000);
    } else {
      alert(message);
    }

    // Limpiar URL
    const cleanUrl = new URL(window.location);
    cleanUrl.searchParams.delete('stripe_error');
    cleanUrl.searchParams.delete('user_id');
    window.history.replaceState({}, '', cleanUrl.toString());
  }

  // Configurar botones del modal
  const createBtn = document.getElementById('createCauseAfterStripe');
  if (createBtn) {
    createBtn.onclick = () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
      
      // Trigger crear causa si estamos en la página de causas
      if (window.location.pathname === '/causes' || window.location.pathname === '/causes/') {
        setTimeout(() => {
          const createCauseBtn = document.getElementById('create-cause-btn');
          if (createCauseBtn) {
            createCauseBtn.click();
          } else {
            window.location.href = '/causes/create';
          }
        }, 100);
      } else {
        window.location.href = '/causes';
      }
    };
  }

  const exploreBtn = document.getElementById('exploreCausesBtn');
  if (exploreBtn) {
    exploreBtn.onclick = () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
      window.location.href = '/causes';
    };
  }

  const closeBtn = document.getElementById('closeStripeSuccessModal');
  if (closeBtn) {
    closeBtn.onclick = () => {
      document.getElementById('stripeSuccessModal').classList.remove('active');
      document.body.style.overflow = '';
    };
  }

  // Cerrar modal al hacer clic fuera
  const modal = document.getElementById('stripeSuccessModal');
  if (modal) {
    modal.onclick = (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    };
  }
});
</script>
</body>
</html>